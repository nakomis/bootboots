{
  "name": "nakomis-bootboots-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "pnpm@11.5.1",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "build:sandbox": "VITE_BOOTBOOTS_IDENTITY_POOL_ID=$(aws ssm get-parameter --name /nakomis-bootboots/sandbox/identity-pool-id --query Parameter.Value --output text) && test -n \"$VITE_BOOTBOOTS_IDENTITY_POOL_ID\" && export VITE_BOOTBOOTS_IDENTITY_POOL_ID && pnpm build",
    "preview": "vite preview",
    "test": "vitest run --coverage",
    "test:watch": "vitest",
    "typecheck": "tsc -b",
    "lint": "biome check .",
    "format": "biome format --write ."
  },
  "dependencies": {
    "@aws-crypto/sha256-js": "^5.2.0",
    "@aws-sdk/client-dynamodb": "^3.1149.0",
    "@aws-sdk/client-s3": "^3.1149.0",
    "@aws-sdk/lib-dynamodb": "^3.1149.0",
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@mui/icons-material": "^7.3.11",
    "@mui/material": "^7.3.11",
    "@smithy/signature-v4": "^5.7.4",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router": "^7.18.4"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.15",
    "@module-federation/vite": "^1.23.4",
    "@smithy/types": "^4.19.0",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/web-bluetooth": "^0.0.21",
    "@vitejs/plugin-react": "^6.1.2",
    "@vitest/coverage-v8": "^5.0.3",
    "aws-sdk-client-mock": "^4.1.0",
    "jsdom": "^30.1.2",
    "typescript": "~5.9.3",
    "vite": "^8.3.4",
    "vitest": "^5.0.3"
  }
}
