{
  "name": "bootboots-infra",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.5.1",
  "scripts": {
    "build": "tsc --noEmit",
    "test": "jest --coverage",
    "cdk": "cdk",
    "synth-sandbox": "NPM_ENVIRONMENT=sandbox cdk synth --profile nakom.is-sandbox --all",
    "synth-prod": "NPM_ENVIRONMENT=prod cdk synth --profile nakom.is-prod --all",
    "diff-sandbox": "NPM_ENVIRONMENT=sandbox cdk diff --profile nakom.is-sandbox",
    "diff-prod": "NPM_ENVIRONMENT=prod cdk diff --profile nakom.is-prod",
    "deploy-sandbox": "NPM_ENVIRONMENT=sandbox cdk deploy --profile nakom.is-sandbox --all",
    "deploy-prod": "NPM_ENVIRONMENT=prod cdk deploy --profile nakom.is-prod --all",
    "deploy-stack-sandbox": "NPM_ENVIRONMENT=sandbox cdk deploy --profile nakom.is-sandbox",
    "deploy-stack-prod": "NPM_ENVIRONMENT=prod cdk deploy --profile nakom.is-prod",
    "ci-synth-sandbox": "NPM_ENVIRONMENT=sandbox CDK_DEFAULT_ACCOUNT=000000000000 cdk synth --all --output cdk-ci-sandbox.out",
    "ci-synth-prod": "NPM_ENVIRONMENT=prod CDK_DEFAULT_ACCOUNT=000000000000 cdk synth --all --output cdk-ci-prod.out",
    "ci-deploy-sandbox": "NPM_ENVIRONMENT=sandbox cdk deploy --all --require-approval never --output cdk-deploy.out"
  },
  "dependencies": {
    "@aws-lambda-powertools/logger": "^2.27.0",
    "aws-cdk-lib": "2.257.0",
    "cdk-iot-core-certificates-v3": "^0.0.14",
    "constructs": "^10.8.1"
  },
  "devDependencies": {
    "@types/aws-lambda": "^8.10.150",
    "@types/jest": "^29.5.14",
    "@types/node": "^22.10.0",
    "aws-cdk": "^2.1145.0",
    "esbuild": "^0.25.0",
    "jest": "^29.7.0",
    "ts-jest": "^29.4.14",
    "ts-node": "^10.9.2",
    "typescript": "~5.9.3"
  }
}
